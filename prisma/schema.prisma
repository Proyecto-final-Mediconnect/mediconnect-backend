generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Tipos ENUM (ver mediconnect-docs/modelo-de-datos/esquema.md § "Tipos ENUM")
// ===========================================================================

/// Canal por el que se registró una aceptación legal (ENG-140).
enum legal_acceptance_source {
  REGISTER
  REACCEPT
}

enum user_role {
  PACIENTE
  PROFESIONAL
  MODERADOR
}

/// Estado de validación de un profesional. Al registrarse queda en
/// PENDIENTE_VALIDACION_MATRICULA; el equipo valida la matrícula manualmente
/// en el MVP (ENG-43).
enum professional_status {
  PENDIENTE_VALIDACION_MATRICULA
  VALIDADO
  RECHAZADO
  SUSPENDIDO
}

enum appointment_status {
  RESERVADO_SIN_PAGAR
  CONFIRMADO
  CANCELADO
  COMPLETADO
  NO_ASISTIO
  LIBERADO
}

enum video_session_status {
  CREADA
  EN_CURSO
  FINALIZADA
}

enum payment_status {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

enum refund_status {
  PENDIENTE
  PROCESADO
  RECHAZADO
}

enum entry_type {
  CONSULTA
  DIAGNOSTICO
  PRESCRIPCION
  ESTUDIO
  CORRECCION
}

enum summary_status {
  PENDIENTE_VALIDACION
  VALIDADO
  DESCARTADO
}

enum review_status {
  PENDIENTE_MODERACION
  APROBADA
  RECHAZADA
}

enum notification_type {
  TURNO_RESERVADO
  RECORDATORIO_24H
  RECORDATORIO_1H
  NUEVO_MENSAJE
  PAGO_CONFIRMADO
  RESENA_MODERADA
  TURNO_CANCELADO
  TURNO_REPROGRAMADO
}

enum notification_channel {
  IN_APP
  PUSH
  EMAIL
}

// ===========================================================================
// EP-01 — Identidad y Acceso
// ===========================================================================

/// Perfil base 1:1 con auth.users de Supabase. Portador del rol.
/// La fila se crea automáticamente vía trigger on_auth_user_created al
/// registrarse el usuario en Supabase Auth (ver migración ep01_*).
model Profile {
  id          String    @id @db.Uuid
  email       String    @unique
  role        user_role
  mfa_enabled Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  patient                Patient?
  professional           Professional?
  notifications          Notification[]
  push_tokens            PushToken[]
  messages               Message[]
  moderated_reviews      Review[]          @relation("ReviewModerator")
  audit_logs             AuditLog[]
  medipass_as_consultant MediPassSession[] @relation("MediPassConsultant")
  medipass_revoked       MediPassSession[] @relation("MediPassRevoker")
  legal_acceptances      LegalAcceptance[]

  @@map("profiles")
}

/// Aceptación de los términos, la política de privacidad y el consentimiento
/// para tratar datos de salud (ENG-140, Ley 25.326 art. 7).
///
/// Una fila por usuario y versión de los textos: cuando cambian, la versión
/// vigente (`LEGAL_VERSION` en `src/legal/legal.ts`) pasa a no estar aceptada y
/// se le vuelve a pedir. Append-only por trigger: es la prueba del
/// consentimiento, no se edita ni se borra. `profile` es RESTRICT por lo mismo.
model LegalAcceptance {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id  String                  @db.Uuid
  version     String                  @db.VarChar(20)
  accepted_at DateTime                @default(now()) @db.Timestamptz(6)
  /// Por dónde se aceptó: al registrarse o desde `POST /me/legal-acceptance`.
  source      legal_acceptance_source
  /// IP real del cliente (`CF-Connecting-IP`, ENG-84). Null si no se pudo determinar.
  ip          String?                 @db.Inet
  user_agent  String?                 @db.VarChar(512)

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([profile_id, version])
  @@map("legal_acceptances")
}

/// Perfil de paciente 1:1 con Profile (role = PACIENTE).
/// Los datos personales se completan en ENG-47, no en el registro.
model Patient {
  profile_id String    @id @db.Uuid
  first_name String
  last_name  String
  birth_date DateTime? @db.Date
  dni        String?   @unique @db.VarChar(15)
  phone      String?
  address    String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)

  // Campos vitales del MediPass (ENG-134). La forma de los `jsonb` la fija el
  // tipo `VitalBlock` que la web ya consume, con las claves en español:
  // allergies `[{ que, gravedad }]`, medications `[{ droga, dosis, nota? }]`,
  // conditions `[{ nombre, codigo }]`, emergency_contact
  // `{ nombre, vinculo, telefono }`. `jsonb` en vez de tres tablas propias es
  // deuda reconocida: ver el comentario de la migración.
  sex               String? @db.VarChar(30)
  blood_type        String? @db.VarChar(3)
  allergies         Json?   @db.JsonB
  medications       Json?   @db.JsonB
  conditions        Json?   @db.JsonB
  emergency_contact Json?   @db.JsonB

  profile                 Profile               @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  appointments            Appointment[]
  reviews                 Review[]
  clinical_record_entries ClinicalRecordEntry[]
  chain_head_snapshot     ChainHeadSnapshot?
  conversations           Conversation[]
  medipass_codes          MediPassCode[]
  medipass_sessions       MediPassSession[]
  medipass_access_logs    MediPassAccessLog[]

  @@map("patients")
}

/// Perfil de profesional 1:1 con Profile (role = PROFESIONAL).
/// Se crea al registrarse (ENG-43) con status PENDIENTE_VALIDACION_MATRICULA.
/// La especialidad se asigna desde el catálogo (professional_specialties) en la
/// validación manual de matrícula; en el registro se captura en metadata.
model Professional {
  profile_id             String              @id @db.Uuid
  first_name             String
  last_name              String
  license_number         String              @db.VarChar(30)
  bio                    String?             @db.VarChar(500)
  photo_url              String?
  consultation_price     Decimal?            @db.Decimal(10, 2)
  currency               String              @default("ARS") @db.Char(3)
  status                 professional_status @default(PENDIENTE_VALIDACION_MATRICULA)
  mercadopago_account_id String?
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime            @default(now()) @db.Timestamptz(6)

  profile                 Profile                 @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  specialties             ProfessionalSpecialty[]
  education               ProfessionalEducation[]
  schedule_rules          ScheduleRule[]
  schedule_blocks         ScheduleBlock[]
  cancellation_policy     CancellationPolicy?
  appointments            Appointment[]
  reviews                 Review[]
  review_responses        ReviewResponse[]
  clinical_record_entries ClinicalRecordEntry[]
  conversations           Conversation[]
  validated_summaries     ConsultationSummary[]

  @@index([status])
  // Catálogo público (ENG-49): el listado siempre filtra por status = VALIDADO
  // y ordena por apellido/nombre; el índice cubre el ORDER BY del scroll
  // infinito para que las páginas altas no cuesten un sort de la tabla entera.
  @@index([status, last_name, first_name, profile_id])
  // Filtro por rango de precio dentro de los validados.
  @@index([status, consultation_price])
  @@map("professionals")
}

// ===========================================================================
// EP-02 — Catálogo, Búsqueda y Reseñas
// ===========================================================================

/// Catálogo curado de especialidades.
model Specialty {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  professionals ProfessionalSpecialty[]

  @@map("specialties")
}

/// Junction N:M profesional ↔ especialidad (máx. 3 por profesional, validado en backend).
model ProfessionalSpecialty {
  professional_id String @db.Uuid
  specialty_id    String @db.Uuid

  professional Professional @relation(fields: [professional_id], references: [profile_id], onDelete: Cascade)
  specialty    Specialty    @relation(fields: [specialty_id], references: [id], onDelete: Restrict)

  @@id([professional_id, specialty_id])
  // La PK solo sirve para buscar "las especialidades de X". El filtro del
  // catálogo va al revés (los profesionales de una especialidad) — ENG-49.
  @@index([specialty_id])
  @@map("professional_specialties")
}

/// Formación académica del profesional (1:N).
model ProfessionalEducation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professional_id String   @db.Uuid
  institution     String
  degree          String
  year            Int?     @db.SmallInt
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  professional Professional @relation(fields: [professional_id], references: [profile_id], onDelete: Cascade)

  @@map("professional_education")
}

/// Reseña de un paciente a un profesional, atada al turno atendido (1 reseña por turno).
model Review {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id        String        @db.Uuid
  professional_id   String        @db.Uuid
  appointment_id    String        @unique @db.Uuid
  rating            Int           @db.SmallInt
  comment           String?
  status            review_status @default(PENDIENTE_MODERACION)
  moderator_id      String?       @db.Uuid
  moderation_reason String?
  moderated_at      DateTime?     @db.Timestamptz(6)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)

  patient      Patient         @relation(fields: [patient_id], references: [profile_id])
  professional Professional    @relation(fields: [professional_id], references: [profile_id])
  appointment  Appointment     @relation(fields: [appointment_id], references: [id])
  moderator    Profile?        @relation("ReviewModerator", fields: [moderator_id], references: [id])
  response     ReviewResponse?

  @@map("reviews")
}

/// Respuesta pública del profesional (1:1 con la reseña).
model ReviewResponse {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  review_id       String   @unique @db.Uuid
  professional_id String   @db.Uuid
  content         String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  review       Review       @relation(fields: [review_id], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professional_id], references: [profile_id])

  @@map("review_responses")
}

// ===========================================================================
// EP-03 — Agenda y Turnos
// ===========================================================================

/// Disponibilidad semanal recurrente del profesional. Una fila por franja: un
/// mismo `weekday` puede tener varias (turno mañana y turno tarde), por eso no
/// hay unique sobre (professional_id, weekday). El solape entre franjas del mismo
/// día lo valida el service (ENG-53).
model ScheduleRule {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professional_id       String   @db.Uuid
  weekday               Int      @db.SmallInt
  start_time            DateTime @db.Time(6)
  end_time              DateTime @db.Time(6)
  slot_duration_minutes Int      @db.SmallInt
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  professional Professional @relation(fields: [professional_id], references: [profile_id], onDelete: Cascade)

  @@index([professional_id])
  @@map("schedule_rules")
}

/// Bloqueos puntuales / feriados. `start_time`/`end_time` en null significan el
/// día completo; con valor, solo esa franja de ese día (ENG-53).
model ScheduleBlock {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professional_id String    @db.Uuid
  block_date      DateTime  @db.Date
  start_time      DateTime? @db.Time(6)
  end_time        DateTime? @db.Time(6)
  reason          String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  professional Professional @relation(fields: [professional_id], references: [profile_id], onDelete: Cascade)

  // El índice real se crea en la migración de ENG-53 con `nulls not distinct`
  // (PG 15+), modificador que Prisma todavía no sabe expresar. Se declara acá
  // igual, con el mismo nombre, para que Prisma no lo vea como drift y proponga
  // borrarlo. Sin ese modificador el índice no serviría para el caso "día
  // completo" (start_time null), porque NULL != NULL.
  @@unique([professional_id, block_date, start_time], map: "schedule_blocks_professional_date_start_key")
  @@index([professional_id, block_date])
  @@map("schedule_blocks")
}

/// Política de cancelación/reembolso por profesional (1:1).
model CancellationPolicy {
  professional_id        String   @id @db.Uuid
  hours_full_refund      Int?     @db.SmallInt
  hours_partial_refund   Int?     @db.SmallInt
  partial_refund_percent Int?     @db.SmallInt
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @db.Timestamptz(6)

  professional Professional @relation(fields: [professional_id], references: [profile_id], onDelete: Cascade)

  @@map("cancellation_policies")
}

/// Turno reservado. La relación profesional↔paciente se deriva de esta tabla.
///
/// La migración de ENG-54 agrega `appointments_professional_active_slot_key`: un
/// unique PARCIAL sobre (professional_id, scheduled_at) limitado a los estados que
/// ocupan el horario (RESERVADO_SIN_PAGAR, CONFIRMADO). Es lo que impide que dos
/// pacientes reserven el mismo turno a la vez, y no se puede declarar acá: Prisma
/// no sabe expresar la cláusula `where` de un índice parcial. Un `@@unique` sin
/// esa cláusula NO es equivalente — impediría revender un turno cancelado — así
/// que el índice vive solo en el SQL de la migración.
model Appointment {
  id                            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id                    String             @db.Uuid
  professional_id               String             @db.Uuid
  scheduled_at                  DateTime           @db.Timestamptz(6)
  duration_minutes              Int                @db.SmallInt
  price                         Decimal            @db.Decimal(10, 2)
  status                        appointment_status @default(RESERVADO_SIN_PAGAR)
  cancellation_reason           String?
  cancelled_at                  DateTime?          @db.Timestamptz(6)
  /// Copia de la política de cancelación al reservar (ENG-65). La escribe un
  /// trigger; NULL = el profesional no tenía política y aplica el default.
  policy_hours_full_refund      Int?               @db.SmallInt
  policy_hours_partial_refund   Int?               @db.SmallInt
  policy_partial_refund_percent Int?               @db.SmallInt
  /// Cuándo se movió de horario (ENG-66). Un turno se reprograma una sola vez.
  rescheduled_at                DateTime?          @db.Timestamptz(6)
  created_at                    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime           @default(now()) @db.Timestamptz(6)

  patient       Patient        @relation(fields: [patient_id], references: [profile_id])
  professional  Professional   @relation(fields: [professional_id], references: [profile_id])
  consultation  Consultation?
  payment       Payment?
  review        Review?
  notifications Notification[]

  @@index([professional_id, scheduled_at])
  @@index([patient_id, scheduled_at])
  @@map("appointments")
}

// ===========================================================================
// EP-05 — Consulta y Videoconsulta
// ===========================================================================

/// Sesión efectivamente realizada (glosario: Consulta), 1:1 con el turno.
model Consultation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointment_id     String    @unique @db.Uuid
  started_at         DateTime? @db.Timestamptz(6)
  ended_at           DateTime? @db.Timestamptz(6)
  professional_notes String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  appointment             Appointment           @relation(fields: [appointment_id], references: [id])
  video_session           VideoSession?
  summary                 ConsultationSummary?
  clinical_record_entries ClinicalRecordEntry[]

  @@map("consultations")
}

/// Sala de Daily.co asociada a la consulta (ADR-010).
model VideoSession {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultation_id     String               @unique @db.Uuid
  daily_room_name     String?
  daily_room_url      String?
  audio_recording_url String?
  status              video_session_status @default(CREADA)
  started_at          DateTime?            @db.Timestamptz(6)
  ended_at            DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)

  consultation Consultation @relation(fields: [consultation_id], references: [id], onDelete: Cascade)

  @@map("video_sessions")
}

// ===========================================================================
// EP-04 — Pagos (MercadoPago, ADR-013)
// ===========================================================================

/// Pago de un turno (1:1). No se almacenan datos de tarjeta (PCI queda en MercadoPago).
model Payment {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointment_id            String         @unique @db.Uuid
  mercadopago_preference_id String?
  mercadopago_payment_id    String?
  amount                    Decimal        @db.Decimal(10, 2)
  currency                  String         @default("ARS") @db.Char(3)
  method                    String?
  status                    payment_status @default(PENDIENTE)
  confirmed_at              DateTime?      @db.Timestamptz(6)
  created_at                DateTime       @default(now()) @db.Timestamptz(6)

  appointment    Appointment           @relation(fields: [appointment_id], references: [id])
  webhook_events PaymentWebhookEvent[]
  refunds        Refund[]

  @@map("payments")
}

/// Bitácora cruda de webhooks de MercadoPago (idempotencia + auditoría de firma).
model PaymentWebhookEvent {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id             String?   @db.Uuid
  mercadopago_payment_id String?
  raw_payload            Json      @db.JsonB
  signature              String?
  processed              Boolean   @default(false)
  received_at            DateTime  @default(now()) @db.Timestamptz(6)
  processed_at           DateTime? @db.Timestamptz(6)

  payment Payment? @relation(fields: [payment_id], references: [id])

  @@index([mercadopago_payment_id])
  @@map("payment_webhook_events")
}

/// Reembolsos (1:N sobre un pago).
model Refund {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id            String        @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  status                refund_status @default(PENDIENTE)
  reason                String?
  mercadopago_refund_id String?
  processed_at          DateTime?     @db.Timestamptz(6)
  created_at            DateTime      @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [payment_id], references: [id])

  @@map("refunds")
}

// ===========================================================================
// EP-06 — Historia Clínica (append-only + cadena de hash, ADR-014/015)
// ===========================================================================

/// Entrada inmutable de HC. Los datos clínicos se guardan como recurso FHIR R5 en
/// content (JSONB). La inmutabilidad (append-only) y la cadena de hash se aplican
/// vía RLS/triggers en una migración de EP-06, no desde Prisma.
model ClinicalRecordEntry {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String     @db.Uuid
  professional_id    String     @db.Uuid
  consultation_id    String?    @db.Uuid
  /// Unique (ENG-100): una entrada tiene a lo sumo UNA corrección, así el
  /// historial es lineal y la última es la vigente. Los NULL no chocan entre sí.
  corrects_entry_id  String?    @unique @db.Uuid
  entry_type         entry_type
  fhir_resource_type String
  content            Json       @db.JsonB
  sequence_number    BigInt
  content_hash       String     @db.Char(64)
  previous_hash      String     @db.Char(64)
  /// Timestamptz(3) y SIN `default now()`, las dos cosas a propósito (hallazgo
  /// bloqueante del spike ENG-45, aplicado en ENG-85 porque es lo que hace
  /// verificable la cadena):
  ///
  ///   - Con `timestamptz(6)` Postgres guarda microsegundos y el `Date` de JS
  ///     solo tiene milisegundos. Como `created_at` entra a la preimagen del
  ///     hash, al releer la entrada para verificarla se pierden los micros, el
  ///     hash recalculado no coincide y el job reporta CONTENT_TAMPERED sobre
  ///     una fila que nadie tocó.
  ///   - El valor lo genera la APLICACIÓN: para sellar la entrada hay que tener
  ///     el timestamp exacto en memoria en el momento de calcular el hash, y con
  ///     `default now()` lo elige la base después.
  created_at         DateTime   @db.Timestamptz(3)

  patient      Patient              @relation(fields: [patient_id], references: [profile_id])
  professional Professional         @relation(fields: [professional_id], references: [profile_id])
  consultation Consultation?        @relation(fields: [consultation_id], references: [id])
  corrects     ClinicalRecordEntry? @relation("EntryCorrections", fields: [corrects_entry_id], references: [id])
  corrected_by ClinicalRecordEntry? @relation("EntryCorrections")
  summary      ConsultationSummary?

  @@unique([patient_id, sequence_number])
  @@index([patient_id, sequence_number])
  @@map("clinical_record_entries")
}

// ===========================================================================
// EP-07 — Inteligencia Artificial Clínica
// ===========================================================================

/// Transcripción (Whisper) + resumen estructurado (Gemini) pendiente de validación
/// profesional (ADR-012). Solo al validarse se incorpora como entrada de HC.
model ConsultationSummary {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultation_id       String         @unique @db.Uuid
  transcription_text    String?
  summary_content       Json?          @db.JsonB
  status                summary_status @default(PENDIENTE_VALIDACION)
  validated_by          String?        @db.Uuid
  incorporated_entry_id String?        @unique @db.Uuid
  generated_at          DateTime?      @db.Timestamptz(6)
  validated_at          DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)

  consultation       Consultation         @relation(fields: [consultation_id], references: [id])
  validator          Professional?        @relation(fields: [validated_by], references: [profile_id])
  incorporated_entry ClinicalRecordEntry? @relation(fields: [incorporated_entry_id], references: [id])

  @@map("consultation_summaries")
}

// ===========================================================================
// EP-08 — Comunicación
// ===========================================================================

/// Hilo único por par paciente-profesional.
model Conversation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id      String   @db.Uuid
  professional_id String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  /// "Borrar chat" de cada lado (ENG-70): lo oculta solo de esa bandeja. Un mensaje nuevo limpia las dos.
  patient_hidden_at      DateTime? @db.Timestamptz(6)
  professional_hidden_at DateTime? @db.Timestamptz(6)

  patient      Patient      @relation(fields: [patient_id], references: [profile_id])
  professional Professional @relation(fields: [professional_id], references: [profile_id])
  messages     Message[]

  @@unique([patient_id, professional_id])
  @@index([professional_id])
  @@map("conversations")
}

/// Mensajes del chat (ADR-011, Supabase Realtime).
model Message {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String    @db.Uuid
  sender_id       String    @db.Uuid
  content         String?
  attachment_url  String?
  read_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [sender_id], references: [id])

  @@index([conversation_id, created_at])
  @@map("messages")
}

/// Notificaciones in-app / push / email.
model Notification {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String               @db.Uuid
  type       notification_type
  channel    notification_channel
  payload    Json?                @db.JsonB
  sent_at    DateTime?            @db.Timestamptz(6)
  read_at    DateTime?            @db.Timestamptz(6)
  created_at DateTime             @default(now()) @db.Timestamptz(6)

  /// Turno al que se refiere el aviso (ENG-68). `null` en los que no son de un turno.
  appointment_id String? @db.Uuid

  user        Profile      @relation(fields: [user_id], references: [id])
  appointment Appointment? @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  /// Un aviso de cada tipo por turno y canal: evita mandar dos veces el mismo email.
  @@unique([appointment_id, type, channel])
  @@map("notifications")
}

/// Tokens de Expo Push por dispositivo.
model PushToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  platform   String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// ===========================================================================
// EP-09 — MediPass
// ===========================================================================

/// Código rotatorio del MediPass, vigente 5 minutos.
///
/// **No es de un solo uso**, a diferencia de lo que decía este comentario hasta
/// ENG-170: cada canje abre su propia sesión y el código sigue sirviendo hasta
/// que rota (ver `MediPassService.openSession`). Es deliberado —un médico que
/// recarga la página no puede quedar afuera, y en una guardia puede haber más de
/// uno mirando— y es lo que hace posible revocar un acceso sin cortar los otros.
/// `used_at` guarda cuándo se usó por primera vez, no es una traba.
model MediPassCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id String    @db.Uuid
  /// Único por ENG-170: dos códigos vigentes iguales le entregaban al consultante
  /// la ficha del paciente equivocado. La generación reintenta ante `P2002`.
  code       String    @unique @db.VarChar(8)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  patient  Patient           @relation(fields: [patient_id], references: [profile_id], onDelete: Cascade)
  sessions MediPassSession[]

  @@index([code, expires_at])
  @@index([patient_id, expires_at])
  @@map("medipass_codes")
}

/// Sesión de acceso de un consultante (por defecto 30 min, revocable).
model MediPassSession {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id            String    @db.Uuid
  medipass_code_id      String    @db.Uuid
  consultant_profile_id String?   @db.Uuid
  consultant_name       String?
  consultant_license    String?   @db.VarChar(30)
  expires_at            DateTime  @db.Timestamptz(6)
  revoked_at            DateTime? @db.Timestamptz(6)
  revoked_by            String?   @db.Uuid
  started_at            DateTime  @default(now()) @db.Timestamptz(6)

  patient     Patient             @relation(fields: [patient_id], references: [profile_id])
  code        MediPassCode        @relation(fields: [medipass_code_id], references: [id])
  consultant  Profile?            @relation("MediPassConsultant", fields: [consultant_profile_id], references: [id])
  revoker     Profile?            @relation("MediPassRevoker", fields: [revoked_by], references: [id])
  access_logs MediPassAccessLog[]

  @@index([patient_id, expires_at])
  @@map("medipass_sessions")
}

/// Auditoría de accesos dentro de una sesión MediPass. Append-only por trigger
/// (ENG-87), igual que `audit_logs`.
model MediPassAccessLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String   @db.Uuid
  patient_id        String   @db.Uuid
  resource_accessed String?
  accessed_at       DateTime @default(now()) @db.Timestamptz(6)

  session MediPassSession @relation(fields: [session_id], references: [id])
  patient Patient         @relation(fields: [patient_id], references: [profile_id])

  @@map("medipass_access_logs")
}

// ===========================================================================
// EP-10 — Plataforma y Auditoría
// ===========================================================================

/// Bitácora inmutable de accesos a HC/MediPass y acciones sensibles.
///
/// Append-only por trigger, TRUNCATE incluido (ENG-87): ni UPDATE ni DELETE,
/// tampoco para el owner. `actor` es RESTRICT y no SET NULL: borrar un perfil no
/// puede borrarle a los registros quién accedió.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id      String?  @db.Uuid
  action        String
  resource_type String
  resource_id   String?  @db.Uuid
  metadata      Json?    @db.JsonB
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  actor Profile? @relation(fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("audit_logs")
}

/// Resultado del job semanal de verificación de la cadena de hash (TT-03 / ENG-85).
///
/// `status`: `OK` | `INCONSISTENT` | `ANCHOR_REGRESSION` | `ERROR`. Los dos
/// últimos no están en esquema.md a propósito del documento y los agregan los
/// tickets, por la misma razón en los dos casos: un estado colapsado dentro de
/// otro deja una racha de "OK" que nadie mira.
///
/// `ERROR` (ENG-85): la corrida no pudo terminar (base caída, credencial
/// vencida). NO es lo mismo que una corrida que verificó y no encontró nada.
///
/// `ANCHOR_REGRESSION` (ENG-123): todas las cadenas verificaron, pero la raíz del
/// ancla cambió sin que la HC creciera. Se distingue de `OK` porque la búsqueda
/// de la línea de base filtra por `OK`: registrarla como sana haría que la
/// corrida siguiente adoptara la raíz manipulada como referencia y el job diera
/// verde para siempre. Estas filas llevan `inconsistencies_found = 0`.
///
/// `details` lleva el resumen de la corrida y las inconsistencias (paciente,
/// `sequence_number`, motivo). NUNCA lleva `content`: el contenido clínico no
/// sale de `clinical_record_entries`.
model IntegrityCheck {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                String
  inconsistencies_found Int      @default(0)
  details               Json?    @db.JsonB
  run_at                DateTime @default(now()) @db.Timestamptz(6)

  @@index([run_at])
  @@map("integrity_checks")
}

/// Cabeza de la cadena de HC de cada paciente al cierre de la última corrida sana
/// del job de ENG-85.
///
/// Existe por el segundo agujero que documenta el spike ENG-45: **una cadena de
/// hash no conoce su propia longitud**. Si se borran las últimas N entradas de un
/// paciente, las que quedan siguen contiguas, enlazadas y arrancando en el
/// génesis — `verifyChain` devuelve `valid: true` y el truncado pasa invisible.
/// Clínicamente es el ataque más plausible: para ocultar un diagnóstico reciente
/// es más simple borrarlo que falsificarlo.
///
/// Guardando la cabeza de la corrida anterior, la siguiente puede afirmar dos
/// cosas que la cadena sola no puede: que la cadena no se acortó, y que la
/// entrada que era cabeza sigue teniendo el mismo hash (o sea que la historia no
/// se reescribió por debajo de las entradas nuevas).
///
/// Límite conocido: la tabla vive en la misma base que protege, así que un
/// atacante con acceso de escritura puede reescribirla junto con la cadena. La
/// mitigación real es el anclaje externo, que es otra tarea técnica; esto sube el
/// costo del ataque y detecta todo lo que no sea un atacante con ese nivel de
/// acceso.
model ChainHeadSnapshot {
  patient_id      String   @id @db.Uuid
  /// `content_hash` de la última entrada vista.
  head_hash       String   @db.Char(64)
  /// `sequence_number` de esa entrada. Con la cadena validada, es también la
  /// cantidad de entradas (la secuencia arranca en 1 y es contigua).
  sequence_number BigInt
  first_seen_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @db.Timestamptz(3)

  patient Patient @relation(fields: [patient_id], references: [profile_id])

  @@map("chain_head_snapshots")
}
