# Dependencias
node_modules/
.pnpm-store/

# Build / output
dist/
build/
.next/
out/

# Artefactos de compilar scripts TS en el lugar (seed.ts, verify-rls.ts, etc.)
# El fuente versionado es el .ts; estos se regeneran con tsc/ts-node.
prisma/*.js
prisma/*.d.ts
prisma/*.js.map
scripts/*.js
scripts/*.d.ts
scripts/*.js.map

# Variables de entorno 
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Caché de herramientas
.vite/
.cache/
coverage/

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code (config local, no del repo)
.claude/

# Prisma (solo backend) - el cliente generado, se regenera, no se versiona
# /src/generated/prisma
/generated/prisma
