# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# DESARROLLO LOCAL: Postgres del docker-compose. Este es el valor por defecto.
#   - Dentro del devcontainer, el host es "db" (nombre del servicio).
#   - Si corrés el backend en tu host (no en el devcontainer), usá "localhost".
DATABASE_URL="postgresql://postgres:postgres@db:5432/mediconnect?schema=public"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediconnect?schema=public"
#
# PRODUCCIÓN: connection string del proyecto Supabase (NO se versiona).

# ---------------------------------------------------------------------------
# Base de datos de test (PostgreSQL 15 en Docker, ver docker-compose.yml).
# ---------------------------------------------------------------------------
# `pnpm run test:integration` ya usa estos valores por defecto internamente;
# solo hace falta declararlos acá si querés sobreescribir puerto/usuario/db.
# DATABASE_URL de test: postgresql://mediconnect:mediconnect@localhost:5433/mediconnect_test?schema=public
POSTGRES_TEST_USER="mediconnect"
POSTGRES_TEST_PASSWORD="mediconnect"
POSTGRES_TEST_DB="mediconnect_test"
POSTGRES_TEST_PORT="5433"

# ---------------------------------------------------------------------------
# Supabase (SOLO producción / staging; en local no se usa)
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Autenticación (Supabase Auth)
# No se usa secreto de JWT: los tokens se firman con claves asimétricas (ES256)
# y se verifican en el backend contra el JWKS de Supabase, derivado de SUPABASE_URL
# (https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json). Ver ENG-40.

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Daily.co (videoconsulta — ENG-51)
# API key de SERVIDOR (Daily Dashboard → Developers). No puede viajar al
# navegador: el front pide la sala a este backend, nunca a api.daily.co.
# Si queda vacía, los endpoints /video/spike responden 503 y el resto de la API
# funciona normal.
DAILY_API_KEY=""
# Solo para apuntar a un mock de la API de Daily; por defecto https://api.daily.co/v1
# DAILY_API_URL=""

# OpenAI Whisper (transcripción)
OPENAI_API_KEY=""

# Google Gemini (resumen clínico)
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Sentry (monitoreo de errores, ENG-83)
# ---------------------------------------------------------------------------
# TODAS opcionales. Sin SENTRY_DSN el SDK queda inactivo y no envía nada, que es
# lo que se espera en local y en CI: así no se ensucia el dashboard con errores
# de desarrollo. Solo se completan en producción/staging.
#
# El DSN no es un secreto (solo habilita el envío de eventos), pero igual no se
# versiona con valor para no atar el repo a un proyecto de Sentry concreto.
SENTRY_DSN=""
# development | staging | production. Si no se declara, cae a NODE_ENV.
SENTRY_ENVIRONMENT=""
# Versión desplegada, ej. el SHA del commit. Permite distinguir errores nuevos
# de los que ya venían de antes.
SENTRY_RELEASE=""

# ---------------------------------------------------------------------------
# Slack (alertas del job de integridad de la HC, ENG-85)
# ---------------------------------------------------------------------------
# Incoming Webhook del canal del equipo. OPCIONAL: sin esto el job de
# `.github/workflows/integrity-check.yml` verifica y registra igual en
# `integrity_checks`, solo que no alerta (y lo deja dicho en el log). En local y
# en CI se deja vacío a propósito.
#
# ES UN SECRETO: la URL sola habilita a publicar en el canal. En producción va
# como `secrets.SLACK_WEBHOOK_URL` en GitHub Actions, nunca en el repo.
SLACK_WEBHOOK_URL=""

# App
PORT="3000"
NODE_ENV="development"

# Origen del frontend permitido por CORS (credentials: true, ver main.ts).
# Default si no se declara: http://localhost:5173 (puerto default de Vite).
WEB_ORIGIN="http://localhost:5173"

# Grabación de audio de la videoconsulta (ENG-56). Valores: off | cloud-audio-only
# Vacío u "off" = no se graba. Prenderlo NO es solo cambiar esto: requiere
# consentimiento del paciente y base legal (Ley 25.326) y un plan pago de Daily
# (la grabación se factura por minuto grabado + almacenamiento).
VIDEO_RECORDING_MODE="off"
